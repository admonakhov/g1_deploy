# Select by target architecture, including CMake toolchains for cross builds.
# Keep the automatic choice out of the cache so it cannot become a stale override.
set(ONNXRUNTIME_ROOT "" CACHE PATH "Optional ONNX Runtime distribution; empty selects the target architecture automatically")
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _ort_processor)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "G1 ONNX Runtime deployment supports Linux targets only")
endif()
if(_ort_processor MATCHES "^(aarch64|arm64)$")
  set(_ort_arch "aarch64")
  set(_ort_machine "b700")
  set(_ort_default "${CMAKE_CURRENT_LIST_DIR}/../third_party/onnxruntime-linux-aarch64-1.23.2")
elseif(_ort_processor MATCHES "^(x86_64|amd64|x64)$")
  set(_ort_arch "x86_64")
  set(_ort_machine "3e00")
  set(_ort_default "${CMAKE_CURRENT_LIST_DIR}/../third_party/onnxruntime-linux-x64-1.22.0")
else()
  message(FATAL_ERROR "Unsupported ONNX Runtime target architecture: ${CMAKE_SYSTEM_PROCESSOR}; expected aarch64/arm64 or x86_64/AMD64")
endif()
if("${ONNXRUNTIME_ROOT}" STREQUAL "")
  set(_ort_root "${_ort_default}")
else()
  set(_ort_root "${ONNXRUNTIME_ROOT}")
endif()
get_filename_component(ONNXRUNTIME_ROOT "${_ort_root}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
if(NOT EXISTS "${ONNXRUNTIME_ROOT}/include/onnxruntime_cxx_api.h")
  message(FATAL_ERROR "ONNX Runtime headers not found: ${ONNXRUNTIME_ROOT}/include. Set -DONNXRUNTIME_ROOT=/path/to/target/distribution or clear the override with -UONNXRUNTIME_ROOT")
endif()
# Older builds cached ORT_LIBRARY independently of the distribution. Never reuse
# that value when the user changes ONNXRUNTIME_ROOT or the target toolchain.
unset(ORT_LIBRARY CACHE)
unset(ORT_LIBRARY)
find_library(ORT_LIBRARY NAMES onnxruntime libonnxruntime.so.1
  PATHS "${ONNXRUNTIME_ROOT}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(NOT ORT_LIBRARY)
  message(FATAL_ERROR "ONNX Runtime library not found in ${ONNXRUNTIME_ROOT}/lib; provide a complete target distribution including libonnxruntime.so or libonnxruntime.so.1")
endif()
set(_ort_library "${ORT_LIBRARY}")
unset(ORT_LIBRARY CACHE)
set(ORT_LIBRARY "${_ort_library}")
# Inspect ELF directly: this works for cross builds without executing target code
# or depending on the host's file/readelf programs.
file(READ "${ORT_LIBRARY}" _ort_elf LIMIT 20 HEX)
string(LENGTH "${_ort_elf}" _ort_elf_length)
if(_ort_elf_length LESS 40)
  message(FATAL_ERROR "Invalid ONNX Runtime ELF library: ${ORT_LIBRARY}")
endif()
string(SUBSTRING "${_ort_elf}" 0 12 _ort_ident)
string(SUBSTRING "${_ort_elf}" 36 4 _ort_actual_machine)
if(NOT _ort_ident STREQUAL "7f454c460201" OR NOT _ort_actual_machine STREQUAL _ort_machine)
  message(FATAL_ERROR "ONNX Runtime architecture mismatch: target ${_ort_arch}, library ${ORT_LIBRARY} (ELF machine ${_ort_actual_machine}). Select the matching -DONNXRUNTIME_ROOT or clear an old override with -UONNXRUNTIME_ROOT")
endif()
add_library(teleop_onnxruntime SHARED IMPORTED)
set_target_properties(teleop_onnxruntime PROPERTIES
  IMPORTED_LOCATION "${ORT_LIBRARY}"
  INTERFACE_INCLUDE_DIRECTORIES "${ONNXRUNTIME_ROOT}/include")
message(STATUS "ONNX Runtime: target=${_ort_arch}, library=${ORT_LIBRARY}")
